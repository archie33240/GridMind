<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.kad.controller.GridsViewController">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <!-- ✅ GridPane avec fx:id="gridsContainer" -->
    <GridPane fx:id="gridsContainer" hgap="10" vgap="10" />

    <HBox spacing="10" alignment="CENTER">
        <Button text="←" onAction="#handlePreviousPage" />
        <Label fx:id="pageLabel" text="Page 1/1" />
        <Button text="→" onAction="#handleNextPage" />
    </HBox>
</VBox>